{
  "manifest_version": 3,
  "name": "בוקלי – הזמנות גנים (פרטי)",
  "short_name": "בוקלי גנים",
  "description": "ניהול הזמנות של גנים: שלבים, קישור אישי לכל גן והודעות וואטסאפ מוכנות. הכל נשמר רק במחשב הזה.",
  "version": "1.0.0",
  "action": { "default_title": "בוקלי – הזמנות גנים", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
