{
  "manifest_version": 3,
  "name": "בוקלי – מרכז הפרסום",
  "short_name": "בוקלי פרסום",
  "description": "מה מפרסמים היום, טקסטים מוכנים להעתקה, קמפיינים, מדידה מ-Cloudflare, ותמונות וסרטונים לכל נושא של booqli Games.",
  "version": "1.5.0",
  "action": {
    "default_title": "בוקלי – מה מפרסמים היום?",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "host_permissions": [
    "https://api.cloudflare.com/*"
  ]
}